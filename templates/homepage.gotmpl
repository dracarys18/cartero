<!DOCTYPE html>
<html lang="en" data-tz="{{.TZ}}" data-page="{{if .Archive}}archive{{else}}today{{end}}">
<head>
    <meta charset="UTF-8">
    <script>
        (function () {
            const tz = Intl.DateTimeFormat().resolvedOptions().timeZone;
            const root = document.documentElement;
            if (!tz || root.dataset.tz === tz || document.cookie.split('; ').includes('tz=' + tz)) return;
            document.cookie = 'tz=' + tz + '; path=/; max-age=31536000; samesite=lax';
            if (root.dataset.page === 'archive') location.reload();
        })();
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{.Title}}</title>
    <link rel="canonical" href="{{.Canonical}}">
    <meta name="description" content="{{.Description}}">
    {{if .NoIndex}}<meta name="robots" content="noindex,follow">{{end}}
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="cartero">
    <meta property="og:title" content="{{.Title}}">
    <meta property="og:description" content="{{.Description}}">
    <meta property="og:url" content="{{.Canonical}}">
    <meta property="og:image" content="{{.BaseURL}}/assets/favicon.jpg">
    <meta name="twitter:card" content="summary">
    <meta name="twitter:title" content="{{.Title}}">
    <meta name="twitter:description" content="{{.Description}}">
    <meta name="twitter:image" content="{{.BaseURL}}/assets/favicon.jpg">
    <script type="application/ld+json">
    {"@context":"https://schema.org","@type":"WebSite","name":"cartero","url":"{{.BaseURL}}/","potentialAction":{"@type":"SearchAction","target":{"@type":"EntryPoint","urlTemplate":"{{.BaseURL}}/search?q={search_term_string}"},"query-input":"required name=search_term_string"}}
    </script>
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-XXNGBLNTPW"></script>
    <script>
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date());
        gtag('config', 'G-XXNGBLNTPW');
    </script>
    <link rel="icon" type="image/jpeg" href="/assets/favicon.jpg">
    <link rel="manifest" href="/assets/manifest.webmanifest">
    <meta name="theme-color" content="#ecebe6" media="(prefers-color-scheme: light)">
    <meta name="theme-color" content="#171613" media="(prefers-color-scheme: dark)">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        :root {
            --paper:     #ecebe6;
            --ink:       #222221;
            --ink-soft:  #4b4b47;
            --ink-faint: #85847e;
            --rule:      #d8d6ce;
            --field-bg:  #e4e2da;
            --field-bd:  #c7c4ba;
            --accent:    #8f2d1f;
            --title:     #dc9e63;
            --label:     #4a5f82;
            --thumb-filter: saturate(.94) contrast(1.02);
        }
        @media (prefers-color-scheme: dark) {
            :root {
                --paper:     #191817;
                --ink:       #ebe8e0;
                --ink-soft:  #b0aca2;
                --ink-faint: #827e74;
                --rule:      #33302a;
                --field-bg:  #232120;
                --field-bd:  #423e37;
                --accent:    #e0876a;
                --label:     #93a6c4;
                --thumb-filter: saturate(.92) brightness(.86);
            }
        }
        * { margin: 0; padding: 0; box-sizing: border-box; }
        [hidden] { display: none !important; }
        body {
            background: var(--paper);
            color: var(--ink);
            font-family: "Manrope", -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
            max-width: 1080px;
            margin: 0 auto;
            padding: 26px 30px 80px;
            -webkit-font-smoothing: antialiased;
        }
        a { text-decoration: none; color: inherit; }

        .topbar {
            display: flex; justify-content: flex-start; align-items: center; gap: 16px;
            padding-bottom: 7px; border-bottom: 1px solid var(--ink);
        }
        .search { display: flex; align-items: stretch; }
        .search input {
            font-family: inherit; font-size: .76rem; color: var(--ink);
            background: transparent; border: 1px solid var(--field-bd); border-right: none;
            padding: 5px 9px; width: 156px; outline: none;
            transition: border-color .15s;
        }
        .search input:focus { border-color: var(--ink-faint); }
        .search button {
            font-family: inherit; font-size: .64rem; font-weight: 600;
            text-transform: uppercase; letter-spacing: .09em; color: var(--ink-soft);
            background: var(--field-bg); border: 1px solid var(--field-bd);
            padding: 5px 13px; cursor: pointer; transition: color .15s;
        }
        .search button:hover { color: var(--accent); }
        .search input:focus + button { border-color: var(--ink-faint); }
        .search input::placeholder { color: var(--ink-faint); }
        .results-head {
            display: flex; justify-content: space-between; align-items: baseline; gap: 12px;
            margin-top: 22px; padding-bottom: 8px; border-bottom: 1px solid var(--rule);
            font-size: .82rem; color: var(--ink-soft);
        }
        .results-head a { color: var(--accent); text-transform: uppercase; letter-spacing: .1em; font-size: .66rem; font-weight: 600; }
        .sections {
            display: flex; gap: 18px;
            text-transform: uppercase; letter-spacing: .13em; font-size: .68rem; font-weight: 600;
        }
        .sections a { color: var(--ink-soft); }
        .sections a:hover { color: var(--accent); }
        .masthead {
            display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 16px;
            padding: 13px 0 11px; border-bottom: 3px double var(--ink);
        }
        .nameplate {
            justify-self: start;
            font-family: "Manrope", sans-serif; font-weight: 800;
            font-size: 2rem; line-height: 1; letter-spacing: -.03em; color: var(--ink);
        }
        .masthead .dateline { justify-self: center; text-align: center; }
        .masthead-tools { justify-self: end; display: flex; align-items: center; gap: 12px; }
        .dateline {
            text-transform: uppercase; letter-spacing: .1em; font-size: .64rem; font-weight: 600;
            color: var(--ink-soft);
        }

        .filters {
            position: sticky; top: 0; z-index: 10;
            display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 10px 12px;
            padding: 11px 0;
            background: color-mix(in srgb, var(--paper) 86%, transparent);
            -webkit-backdrop-filter: saturate(1.4) blur(12px);
            backdrop-filter: saturate(1.4) blur(12px);
            border-bottom: 1px solid var(--rule);
            view-transition-name: filters;
        }
        .date-range { display: inline-flex; align-items: center; gap: 6px; font-size: .74rem; color: var(--ink-faint); }
        .date-range input {
            font: inherit; font-size: .74rem; font-weight: 600; color: var(--ink);
            padding: 5px 10px; border: 1px solid var(--field-bd); border-radius: 999px;
            background: transparent; color-scheme: light dark;
        }
        .date-range input:focus { outline: none; border-color: var(--ink-faint); }
        .date-range button {
            font: inherit; font-size: .72rem; font-weight: 700; padding: 6px 14px;
            border: none; border-radius: 999px; background: var(--ink); color: var(--paper); cursor: pointer;
        }
        .filter-menus { display: flex; gap: 8px; margin-left: auto; }
        .archive-link {
            display: inline-flex; align-items: center; gap: 7px;
            text-transform: uppercase; letter-spacing: .13em; font-size: .68rem; font-weight: 600;
            color: var(--ink-soft); transition: color .15s;
        }
        .archive-link svg { width: 14px; height: 14px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
        .archive-link:hover, .archive-link.is-active { color: var(--accent); }
        .filter-menu { position: relative; }
        .filter-menu summary {
            list-style: none; cursor: pointer; user-select: none;
            display: inline-flex; align-items: center; gap: 7px; max-width: 240px;
            font-size: .74rem; font-weight: 600; padding: 6px 13px; border-radius: 999px;
            border: 1px solid var(--field-bd); color: var(--ink);
            transition: border-color .2s;
        }
        .filter-menu summary::-webkit-details-marker { display: none; }
        .filter-menu summary::after {
            content: ""; flex: none; width: 6px; height: 6px;
            border-right: 1.5px solid var(--ink-faint); border-bottom: 1.5px solid var(--ink-faint);
            transform: translateY(-2px) rotate(45deg); transition: transform .2s;
        }
        .filter-menu[open] summary::after { transform: translateY(1px) rotate(-135deg); }
        .filter-menu summary:hover, .filter-menu[open] summary { border-color: var(--ink-faint); }
        .filter-menu.is-set summary { border-color: var(--accent); }
        .filter-name { color: var(--ink-faint); font-weight: 500; }
        .filter-value { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
        .filter-menu.is-set .filter-value { color: var(--accent); }
        .menu {
            position: absolute; right: 0; top: calc(100% + 8px); z-index: 20;
            width: 270px; max-height: min(60vh, 420px); overflow-y: auto; padding: 6px;
            background: var(--paper); border: 1px solid var(--field-bd); border-radius: 10px;
            box-shadow: 0 14px 34px -14px rgba(0, 0, 0, .4);
            animation: menu-in .16s ease-out;
        }
        .menu-search {
            width: 100%; margin-bottom: 4px; padding: 7px 10px;
            font: inherit; font-size: .8rem; color: var(--ink);
            background: var(--field-bg); border: 1px solid var(--field-bd); border-radius: 6px; outline: none;
        }
        .menu-search:focus { border-color: var(--ink-faint); }
        .menu-option {
            display: flex; align-items: center; gap: 10px; cursor: pointer;
            padding: 7px 10px; border-radius: 6px; font-size: .8rem; color: var(--ink-soft);
        }
        .menu-option:hover { background: var(--field-bg); color: var(--ink); }
        .menu-option:has(input:checked) { color: var(--ink); font-weight: 600; }
        .menu-option input { margin: 0; accent-color: var(--accent); }
        .option-label { flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
        .menu-actions {
            position: sticky; bottom: -6px;
            display: flex; justify-content: space-between; align-items: center;
            margin: 6px -6px -6px; padding: 8px 12px;
            background: var(--paper); border-top: 1px solid var(--rule);
        }
        .menu-actions a { font-size: .72rem; font-weight: 600; color: var(--ink-faint); }
        .menu-actions a:hover { color: var(--accent); }
        .menu-actions button {
            font: inherit; font-size: .72rem; font-weight: 700; padding: 6px 16px;
            border: none; border-radius: 999px; background: var(--accent); color: var(--paper); cursor: pointer;
        }
        .menu .count { color: var(--ink-faint); font-size: .72rem; font-variant-numeric: tabular-nums; }
        @keyframes menu-in { from { opacity: 0; transform: translateY(-4px) scale(.98); } }
        .active-filters {
            display: flex; align-items: center; flex-wrap: wrap; gap: 8px;
            margin-top: 16px; font-size: .8rem; color: var(--ink-soft);
        }
        .pill {
            display: inline-flex; align-items: center; gap: 6px;
            padding: 4px 10px; border-radius: 999px;
            font-size: .74rem; font-weight: 600; color: var(--accent);
            background: color-mix(in srgb, var(--accent) 14%, transparent);
            transition: background .2s;
        }
        .pill:hover { background: color-mix(in srgb, var(--accent) 24%, transparent); }
        .clear-all { margin-left: auto; color: var(--accent); font-weight: 600; font-size: .68rem; text-transform: uppercase; letter-spacing: .1em; }

        .kicker {
            display: inline-block; text-transform: uppercase; letter-spacing: .12em;
            font-size: .66rem; font-weight: 600; color: var(--label); margin-bottom: 6px;
        }
        a.kicker:hover { text-decoration: underline; text-underline-offset: 3px; }
        .byline { font-style: normal; color: var(--ink-faint); }
        .src-link { transition: color .15s; }
        .src-link:hover { color: var(--accent); }
        .title-link:hover { color: var(--accent); text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 3px; }

        .stories {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            column-gap: 40px;
            margin-top: 18px;
        }
        .story { display: flex; flex-direction: column; padding: 20px 0 22px; border-bottom: 1px solid var(--rule); }
        .story .kicker { align-self: flex-start; }
        .story-thumb {
            position: relative; display: grid; place-items: center;
            aspect-ratio: 3 / 2; margin-bottom: 12px; overflow: hidden; border-radius: 3px;
            background: var(--field-bg);
        }
        .story-thumb img {
            position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover;
            filter: var(--thumb-filter);
            transition: transform .5s cubic-bezier(.2, .7, .2, 1);
        }
        .story:hover .story-thumb img { transform: scale(1.035); }
        .thumb-label {
            padding: 0 14px; text-align: center;
            font-size: 1.05rem; font-weight: 800; letter-spacing: -.01em;
            color: var(--ink-faint);
        }
        .story-title {
            font-family: "Manrope", sans-serif; font-weight: 700;
            font-size: 1.32rem; line-height: 1.15; letter-spacing: -.006em; margin-bottom: 6px;
            color: var(--title);
        }
        .story .byline { display: flex; flex-wrap: wrap; font-size: .8rem; margin-bottom: 8px; }
        .story .byline > * { white-space: nowrap; }
        .story .byline > * + *::before { content: "·"; margin: 0 .5em; }
        .share-btn {
            background: none; border: none; cursor: pointer; padding: 0;
            display: inline-flex; align-items: center; gap: 4px; vertical-align: baseline;
            color: var(--ink-faint); font-family: inherit;
            font-size: .68rem; font-weight: 600; text-transform: uppercase; letter-spacing: .08em;
        }
        .share-btn:hover { color: var(--accent); }
        .share-btn svg { width: 12px; height: 12px; fill: currentColor; }
        .share-btn.copied { color: var(--accent); }
        .card-actions { display: flex; align-items: center; gap: 14px; margin-top: auto; padding-top: 12px; }
        .orig { color: var(--ink-faint); font-size: .78rem; text-decoration: none; }
        .orig:hover { color: var(--accent); }
        .save-btn {
            background: none; border: none; cursor: pointer; padding: 0;
            color: var(--ink-faint); display: inline-flex; align-items: center; vertical-align: baseline;
        }
        .save-btn svg { width: 15px; height: 15px; fill: none; stroke: currentColor; stroke-width: 1.8; }
        .save-btn:hover { color: var(--accent); }
        .save-btn.saved { color: var(--accent); }
        .save-btn.saved svg { fill: currentColor; }
        .saved-link {
            background: none; border: none; cursor: pointer; padding: 4px;
            color: var(--ink-soft); display: inline-flex; align-items: center; gap: 5px;
        }
        .saved-link:hover { color: var(--accent); }
        .saved-link svg { width: 17px; height: 17px; fill: none; stroke: currentColor; stroke-width: 1.8; }
        .saved-count { font-size: .7rem; font-weight: 700; color: var(--accent); }
        .story-excerpt { font-size: .9rem; line-height: 1.52; color: var(--ink-soft); }

        .pagination {
            display: flex; justify-content: center; align-items: center; gap: 24px;
            margin-top: 44px; padding-top: 20px; border-top: 3px double var(--ink);
            text-transform: uppercase; letter-spacing: .1em; font-size: .72rem; font-weight: 600;
        }
        .pagination a { color: var(--ink-soft); }
        .pagination a:hover { color: var(--accent); }
        .pagination .disabled { color: var(--ink-faint); opacity: .5; }
        .page-info { font-style: normal; text-transform: none; letter-spacing: 0; color: var(--ink-faint); font-weight: 400; }

        .empty { padding: 100px 0; text-align: center; font-style: normal; color: var(--ink-soft); }
        .empty a { color: var(--accent); }

        .colophon {
            margin-top: 34px; padding-top: 16px; border-top: 1px solid var(--rule);
            display: flex; justify-content: space-between; align-items: center;
            font-size: .74rem; color: var(--ink-faint);
        }
        .colophon a { color: var(--ink-soft); margin-right: 15px; }
        .colophon a:hover { color: var(--accent); }

        @media (prefers-reduced-motion: no-preference) {
            @view-transition { navigation: auto; }
            ::view-transition-old(root), ::view-transition-new(root) { animation-duration: .22s; }
            @supports (animation-timeline: view()) {
                .story { animation: story-in linear both; animation-timeline: view(); animation-range: entry 0% entry 35%; }
            }
        }
        @keyframes story-in { from { opacity: 0; transform: translateY(14px); } }
        @media (prefers-reduced-motion: reduce) {
            *, *::before, *::after { animation: none !important; transition: none !important; }
        }

        @media (min-width: 681px) and (max-width: 960px) {
            .stories { grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: 32px; }
        }

        @media (max-width: 680px) {
            body { padding: 18px 16px 56px; }
            .filters { padding: 10px 0; }
            .filter-menu { position: static; }
            .menu { left: 0; right: 0; top: calc(100% + 4px); width: auto; }
            .topbar { justify-content: center; }
            .sections { flex-wrap: wrap; justify-content: center; gap: 12px 14px; }
            .masthead {
                grid-template-columns: 1fr; justify-items: center; text-align: center; gap: 10px;
            }
            .nameplate { justify-self: center; font-size: 1.9rem; }
            .masthead-tools { justify-self: stretch; justify-content: center; flex-wrap: wrap; gap: 10px; }
            .masthead .search { flex: 1; min-width: 180px; }
            .search input { flex: 1; width: auto; }
            .stories { grid-template-columns: 1fr; }
            .stories .story { display: block; overflow: hidden; }
            .story-thumb { float: right; width: 104px; aspect-ratio: 1; margin: 2px 0 6px 14px; }
            .thumb-label { font-size: .72rem; padding: 0 8px; }
            .pagination { flex-wrap: wrap; gap: 12px 18px; }
            .colophon { flex-direction: column; gap: 8px; align-items: flex-start; }
        }
    </style>
</head>
<body>
    <div class="topbar">
        <nav class="sections">
            <a href="/feed.rss">RSS</a>
            <a href="/feed.atom">Atom</a>
            <a href="/feed.json">JSON</a>
            <a href="https://bsky.app/profile/news.karthihegde.dev" target="_blank" rel="noopener">Bluesky</a>
        </nav>
    </div>
    <header class="masthead">
        <a href="/" class="nameplate">cartero</a>
        <span class="dateline">{{.Now.Format "Monday, January 2, 2006"}} · No. {{.Total}}</span>
        <div class="masthead-tools">
            <button class="saved-link" onclick="showSaved(); return false;" aria-label="Saved articles" title="Saved"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M6 3h12a1 1 0 0 1 1 1v16l-7-4-7 4V4a1 1 0 0 1 1-1z"/></svg><span id="saved-count" class="saved-count" hidden>0</span></button>
            <form class="search" method="get" action="/search" role="search">
                <input type="search" name="q" placeholder="Search…" aria-label="Search stories" autocomplete="off">
                <button type="submit">Search</button>
            </form>
        </div>
    </header>

    <nav class="filters" id="filters" aria-label="Filter stories">
        <a class="archive-link{{if .Archive}} is-active{{end}}" href="{{.ArchiveHref}}" title="{{if .Archive}}Back to today{{else}}Browse the archive{{end}}"{{if .Archive}} aria-current="page"{{end}}><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true"><rect x="2.5" y="3.5" width="19" height="5" rx="1"/><path d="M4.5 8.5v10a2 2 0 0 0 2 2h11a2 2 0 0 0 2-2v-10"/><path d="M10 12.5h4"/></svg>Archive</a>
        {{if .Archive}}
        <form class="date-range" method="get" action="/archive">
            {{range .DateHidden}}<input type="hidden" name="{{.Name}}" value="{{.Value}}">{{end}}
            <input type="date" name="from" value="{{.From}}" max="{{.MaxDate}}" aria-label="From date">
            <span aria-hidden="true">–</span>
            <input type="date" name="to" value="{{.To}}" max="{{.MaxDate}}" aria-label="To date">
            <button type="submit">Show</button>
        </form>
        {{end}}
        <div class="filter-menus">
            {{range $m := .Menus}}
            <details class="filter-menu{{if $m.Set}} is-set{{end}}">
                <summary><span class="filter-name">{{$m.Name}}</span><span class="filter-value">{{$m.Summary}}</span></summary>
                <form class="menu" method="get" action="{{$m.Action}}">
                    <input class="menu-search" type="search" placeholder="Filter…" aria-label="Filter {{$m.Name}} options" hidden>
                    {{range $m.Hidden}}<input type="hidden" name="{{.Name}}" value="{{.Value}}">{{end}}
                    {{range $m.Options}}<label class="menu-option"><input type="checkbox" name="{{$m.Param}}" value="{{.Value}}"{{if .Checked}} checked{{end}}><span class="option-label">{{.Label}}</span>{{if .Count}}<span class="count">{{.Count}}</span>{{end}}</label>{{end}}
                    <div class="menu-actions"><a href="{{$m.ClearHref}}">Clear</a><button type="submit">Apply</button></div>
                </form>
            </details>
            {{end}}
        </div>
    </nav>

    <main>
        <div class="results-head" id="results-head" hidden></div>
        <div id="front">
            {{if or .Archive .Filtered}}
            <div class="active-filters">
                <span>{{.Total}} {{if eq .Total 1}}story{{else}}stories{{end}}{{if .Archive}} · {{.RangeLabel}}{{else}} today{{end}}</span>
                {{range .Pills}}<a class="pill" href="{{.Href}}" aria-label="Remove filter: {{.Label}}">{{.Label}} <span aria-hidden="true">×</span></a>{{end}}
                {{if .Filtered}}<a class="clear-all" href="{{.ClearHref}}">clear filters</a>{{end}}
            </div>
            {{end}}
            {{if .Entries}}
            <div class="stories">
                {{range $e := .Entries}}
                <article class="story">
                    <a class="story-thumb" href="/read?url={{$e.Link | urlquery}}&title={{$e.Title | urlquery}}" tabindex="-1" aria-hidden="true"><span class="thumb-label">{{formatSource $e.Source}}</span>{{if $e.ImageURL}}<img src="{{$e.ImageURL}}" alt="" loading="lazy" decoding="async" onerror="this.remove()">{{end}}</a>
                    {{if $e.MatchedKeywords}}<a class="kicker" href="/?topic={{$e.MatchedKeywords | urlquery}}">{{$e.MatchedKeywords}}</a>{{end}}
                    <h3 class="story-title"><a class="title-link" href="/read?url={{$e.Link | urlquery}}&title={{$e.Title | urlquery}}">{{$e.Title}}</a></h3>
                    <div class="byline"><a class="src-link" href="/?source={{$e.Source | urlquery}}">{{formatSource $e.Source}}</a><span>{{timeAgo $e.CreatedAt}}</span>{{if $e.Content}}<span>{{readingTime $e.Content}}</span>{{end}}</div>
                    {{if $e.Description}}<p class="story-excerpt">{{$e.Description}}</p>{{end}}
                    <div class="card-actions"><a class="orig" href="{{$e.Link}}" target="_blank" rel="noopener" title="Original">↗</a><button class="save-btn" data-url="{{$e.Link}}" data-title="{{$e.Title}}" data-image="{{$e.ImageURL}}" data-source="{{$e.Source}}" data-excerpt="{{$e.Description}}" onclick="toggleSave(this)" aria-label="Save"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M6 3h12a1 1 0 0 1 1 1v16l-7-4-7 4V4a1 1 0 0 1 1-1z"/></svg></button><button class="share-btn" data-title="{{$e.Title}}" data-url="{{$e.Link}}" onclick="shareStory(this)" aria-label="Share"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M18 16.08c-.76 0-1.44.3-1.96.77L8.91 12.7c.05-.23.09-.46.09-.7s-.04-.47-.09-.7l7.05-4.11c.54.5 1.25.81 2.04.81 1.66 0 3-1.34 3-3s-1.34-3-3-3-3 1.34-3 3c0 .24.04.47.09.7L8.04 9.81C7.5 9.31 6.79 9 6 9c-1.66 0-3 1.34-3 3s1.34 3 3 3c.79 0 1.5-.31 2.04-.81l7.12 4.16c-.05.21-.08.43-.08.65 0 1.61 1.31 2.92 2.92 2.92s2.92-1.31 2.92-2.92-1.31-2.92-2.92-2.92z"/></svg><span>share</span></button></div>
                </article>
                {{end}}
            </div>

            <div class="pagination">
                {{if .HasPrev}}<a href="{{.PrevURL}}">← Newer</a>{{else}}<span class="disabled">← Newer</span>{{end}}
                <span class="page-info">page {{.Page}} of {{.TotalPages}} · {{.Total}} stories</span>
                {{if .HasNext}}<a href="{{.NextURL}}">Older →</a>{{else}}<span class="disabled">Older →</span>{{end}}
            </div>
            {{else}}
            <div class="empty">{{if .Filtered}}no stories match these filters · <a href="{{.ClearHref}}">clear filters</a>{{else if .Archive}}no stories in this date range{{else}}no stories yet today · <a href="/archive">browse the archive</a>{{end}}</div>
            {{end}}
        </div>
        <div id="results" hidden></div>
        <div id="saved" hidden></div>
    </main>

    <footer class="colophon">
        <div>
            <a href="/feed.rss">RSS</a>
            <a href="/feed.atom">Atom</a>
            <a href="/feed.json">JSON</a>
        </div>
        <div>set by machine · {{.Now.Format "Jan 2, 2006 · 15:04 MST"}}</div>
    </footer>

    <script src="/assets/saved.js"></script>
    <script>
        if ('serviceWorker' in navigator) {
            window.addEventListener('load', function () { navigator.serviceWorker.register('/sw.js'); });
        }
        function shareStory(btn) {
            const title = btn.dataset.title, url = btn.dataset.url;
            const promo = 'Shared from ' + window.location.origin;
            if (navigator.share) {
                navigator.share({ text: url + '\n\n' + promo }).catch(() => {});
                return;
            }
            const text = title + '\n' + url + '\n\n' + promo;
            navigator.clipboard.writeText(text).then(() => {
                const span = btn.querySelector('span');
                span.textContent = 'copied!';
                btn.classList.add('copied');
                setTimeout(() => { span.textContent = 'share'; btn.classList.remove('copied'); }, 2000);
            });
        }

        (function () {
            const form = document.querySelector('.search');
            const input = form.querySelector('input');
            const front = document.getElementById('front');
            const results = document.getElementById('results');
            const head = document.getElementById('results-head');

            function esc(s) { const d = document.createElement('div'); d.textContent = s == null ? '' : s; return d.innerHTML; }
            function safeURL(u) { try { const p = new URL(u, location.origin); return (p.protocol === 'http:' || p.protocol === 'https:') ? p.href : '#'; } catch (e) { return '#'; } }

            function card(r) {
                const link = '/read?url=' + encodeURIComponent(r.link || '') + '&title=' + encodeURIComponent(r.title || '');
                const orig = safeURL(r.link);
                const thumb = thumbHTML(link, r.source, r.image_url);
                const kicker = r.matched_keywords ? `<a class="kicker" href="/?topic=${encodeURIComponent(r.matched_keywords)}">${esc(r.matched_keywords)}</a>` : '';
                const excerpt = r.description ? `<p class="story-excerpt">${esc(r.description)}</p>` : '';
                return `<article class="story">${thumb}${kicker}<h3 class="story-title"><a class="title-link" href="${link}">${esc(r.title)}</a></h3><div class="byline"><span>${esc(r.source)}</span><span>${esc(r.age)}</span></div>${excerpt}<div class="card-actions"><a class="orig" href="${orig}" target="_blank" rel="noopener">↗</a><button class="save-btn" data-url="${escAttr(r.link)}" data-title="${escAttr(r.title)}" data-image="${escAttr(r.image_url || '')}" data-source="${escAttr(r.source)}" data-excerpt="${escAttr(r.description || '')}" onclick="toggleSave(this)" aria-label="Save"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M6 3h12a1 1 0 0 1 1 1v16l-7-4-7 4V4a1 1 0 0 1 1-1z"/></svg></button></div></article>`;
            }

            const filters = document.getElementById('filters');
            function showFront() { input.value = ''; results.hidden = true; head.hidden = true; front.hidden = false; filters.hidden = false; const sv = document.getElementById('saved'); if (sv) sv.hidden = true; }

            async function runSearch(q) {
                front.hidden = true; filters.hidden = true; results.hidden = false; results.innerHTML = '';
                const sv = document.getElementById('saved'); if (sv) sv.hidden = true;
                head.hidden = false; head.innerHTML = '<span>searching…</span>';
                let data;
                try {
                    const res = await fetch('/search?q=' + encodeURIComponent(q), { headers: { 'Accept': 'application/json' }, cache: 'no-store' });
                    data = await res.json();
                } catch (e) { head.innerHTML = '<span>search failed</span> <a href="/">← back</a>'; return; }
                head.innerHTML = `<span>results for “${esc(data.query)}”</span> <a href="/" id="back">← back to front page</a>`;
                head.querySelector('#back').addEventListener('click', function (e) { e.preventDefault(); showFront(); });
                results.innerHTML = data.results.length
                    ? '<div class="stories">' + data.results.map(card).join('') + '</div>'
                    : `<div class="empty">No results found for “${esc(data.query)}”.</div>`;
                refreshSaveButtons();
            }

            form.addEventListener('submit', function (e) {
                e.preventDefault();
                const q = input.value.trim();
                if (!q) { showFront(); return; }
                runSearch(q);
            });

            const q0 = new URLSearchParams(location.search).get('q');
            if (q0) { input.value = q0; runSearch(q0); }
        })();

        function esc(s) { const d = document.createElement('div'); d.textContent = s == null ? '' : String(s); return d.innerHTML; }
        function escAttr(s) { return esc(s).replace(/"/g, '&quot;').replace(/'/g, '&#39;'); }
        function safeURL(u) { try { const p = new URL(u, location.origin); return (p.protocol === 'http:' || p.protocol === 'https:') ? p.href : '#'; } catch (e) { return '#'; } }

        function thumbHTML(link, source, image) {
            const img = image ? `<img src="${safeURL(image)}" alt="" loading="lazy" decoding="async" onerror="this.remove()">` : '';
            return `<a class="story-thumb" href="${link}" tabindex="-1" aria-hidden="true"><span class="thumb-label">${esc(source)}</span>${img}</a>`;
        }

        function savedEntryFromBtn(btn) {
            return {
                url: btn.dataset.url || '',
                title: btn.dataset.title || '',
                image_url: btn.dataset.image || '',
                siteName: btn.dataset.source || '',
                excerpt: btn.dataset.excerpt || ''
            };
        }

        function toggleSave(btn) {
            if (!window.CarteroSaved) return;
            window.CarteroSaved.toggleSaved(savedEntryFromBtn(btn));
        }

        function refreshSaveButtons() {
            if (!window.CarteroSaved) return;
            document.querySelectorAll('.save-btn[data-url]').forEach(function (b) {
                const s = window.CarteroSaved.isSaved(b.dataset.url);
                b.classList.toggle('saved', !!s);
                b.setAttribute('aria-label', s ? 'Remove from saved' : 'Save');
                b.title = s ? 'Remove from saved' : 'Save';
            });
        }

        function updateSavedCount() {
            const n = window.CarteroSaved ? window.CarteroSaved.load().length : 0;
            const el = document.getElementById('saved-count');
            if (el) {
                el.textContent = n;
                el.hidden = n === 0;
            }
        }

        function savedCard(s) {
            const link = '/read?url=' + encodeURIComponent(s.url || '') + '&title=' + encodeURIComponent(s.title || '');
            const orig = safeURL(s.url);
            const thumb = thumbHTML(link, s.siteName, s.image_url);
            const excerpt = s.excerpt ? '<p class="story-excerpt">' + esc(s.excerpt) + '</p>' : '';
            return '<article class="story">' + thumb +
                '<h3 class="story-title"><a class="title-link" href="' + link + '">' + esc(s.title) + '</a></h3>' +
                '<div class="byline"><span>' + esc(s.siteName || '') + '</span></div>' + excerpt +
                '<div class="card-actions"><a class="orig" href="' + orig + '" target="_blank" rel="noopener">↗</a><button class="save-btn saved" data-url="' + escAttr(s.url) + '" data-title="' + escAttr(s.title) + '" data-image="' + escAttr(s.image_url || '') + '" data-source="' + escAttr(s.siteName || '') + '" data-excerpt="' + escAttr(s.excerpt || '') + '" onclick="toggleSave(this)" aria-label="Remove from saved"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M6 3h12a1 1 0 0 1 1 1v16l-7-4-7 4V4a1 1 0 0 1 1-1z"/></svg></button></div></article>';
        }

        function showSaved() {
            const front = document.getElementById('front');
            const results = document.getElementById('results');
            const head = document.getElementById('results-head');
            const saved = document.getElementById('saved');
            const filters = document.getElementById('filters');
            if (front) front.hidden = true;
            if (results) results.hidden = true;
            if (filters) filters.hidden = true;
            if (head) head.hidden = true;
            if (!saved) return;
            saved.hidden = false;
            const list = window.CarteroSaved ? window.CarteroSaved.load() : [];
            if (!list.length) {
                saved.innerHTML = '<div class="empty">no saved articles yet — click “save” on any story</div>';
            } else {
                saved.innerHTML = '<div class="results-head" style="display:flex;justify-content:space-between;align-items:baseline"><span>saved (' + list.length + ')</span><a href="#" onclick="clearAllSaved(); return false;" style="color:var(--accent);text-transform:uppercase;letter-spacing:.1em;font-size:.66rem;font-weight:600">clear all</a></div><div class="stories">' + list.map(savedCard).join('') + '</div>';
            }
            window.scrollTo(0, 0);
        }

        function clearAllSaved() {
            if (window.CarteroSaved) window.CarteroSaved.clearSaved();
            showSaved();
        }

        if (window.CarteroSaved) {
            window.CarteroSaved.onChange(function () { updateSavedCount(); refreshSaveButtons(); });
            updateSavedCount();
            refreshSaveButtons();
        }

        (function () {
            const menus = Array.from(document.querySelectorAll('.filter-menu'));
            const canHover = window.matchMedia('(hover: hover)').matches;

            function close(menu, apply) {
                if (!menu.open) return;
                if (!apply) {
                    menu.querySelector('form').reset();
                    delete menu.dataset.dirty;
                }
                menu.removeAttribute('open');
            }

            menus.forEach(function (menu) {
                const form = menu.querySelector('form');
                const search = menu.querySelector('.menu-search');
                const options = Array.from(menu.querySelectorAll('.menu-option'));
                search.hidden = false;

                menu.addEventListener('toggle', function () {
                    if (!menu.open) {
                        if (menu.dataset.dirty) form.requestSubmit();
                        return;
                    }
                    menus.forEach(function (other) { if (other !== menu) close(other, true); });
                    search.value = '';
                    options.forEach(function (o) { o.hidden = false; });
                    if (canHover) search.focus();
                });

                form.addEventListener('change', function (e) {
                    if (e.target.type === 'checkbox') menu.dataset.dirty = '1';
                });

                search.addEventListener('input', function () {
                    const q = search.value.trim().toLowerCase();
                    options.forEach(function (o) {
                        o.hidden = q !== '' && !o.querySelector('.option-label').textContent.toLowerCase().includes(q);
                    });
                });
            });

            document.addEventListener('click', function (e) {
                menus.forEach(function (menu) { if (!menu.contains(e.target)) close(menu, true); });
            });
            document.addEventListener('keydown', function (e) {
                if (e.key === 'Escape') menus.forEach(function (menu) { close(menu, false); });
            });
        })();

        if (location.hash === '#saved') { showSaved(); }
        window.addEventListener('hashchange', function () { if (location.hash === '#saved') showSaved(); });
    </script>
</body>
</html>
